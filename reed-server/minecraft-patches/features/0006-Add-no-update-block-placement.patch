@@ -1053,7 +1054,16 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     }
 
     @Override
-    public boolean setBlock(final BlockPos pos, final BlockState blockState, final @Block.UpdateFlags int updateFlags, final int updateLimit) {
+    public boolean setBlock(final BlockPos pos, final BlockState blockState, @Block.UpdateFlags int updateFlags, final int updateLimit) {
+        // Reed start - suppress block placement updates
+        if (!this.doBlockPlacementUpdate) {
+            updateFlags = updateFlags
+                & (Block.UPDATE_SUPPRESS_DROPS | Block.UPDATE_SKIP_SHAPE_UPDATE_ON_WIRE | Block.UPDATE_SKIP_BLOCK_ENTITY_SIDEEFFECTS | Block.UPDATE_SKIP_POI)
+                | Block.UPDATE_CLIENTS
+                | Block.UPDATE_KNOWN_SHAPE
+                | Block.UPDATE_SKIP_ON_PLACE;
+        }
+        // Reed end - suppress block placement updates
         // CraftBukkit start - tree generation
         if (this.captureTreeGeneration) {
             // Paper start - Protect Bedrock and End Portal/Frames from being destroyed
