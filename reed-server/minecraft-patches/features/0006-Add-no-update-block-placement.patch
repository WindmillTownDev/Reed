Subject: [PATCH] Add no-update block placement


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 8389d812b2d80a122fd1945b3182c08cdeda7d1c..3702da33ea6645144d81a449a208b3b007620020 100644
