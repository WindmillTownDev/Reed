Subject: [PATCH] Add no-update block placement


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 02bd74f2ed7f34233e3543c8e70ae754adb8aa25..cf92ce7d79cc9edf380073581b61b59004ee623a 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2038,6 +2038,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
     @Override
     public void blockEvent(final BlockPos pos, final Block block, final int b0, final int b1) {
+        if (!this.doBlockPlacementUpdate) return; // Reed - no updates during block placement
         this.blockEvents.add(new BlockEventData(pos, block, b0, b1));
     }
 
