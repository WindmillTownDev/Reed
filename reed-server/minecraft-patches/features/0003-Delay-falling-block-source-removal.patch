From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Windmill1055 <windmill1055@gmail.com>
Date: Mon, 27 Jul 2026 17:53:13 +0800
Subject: [PATCH] Delay falling block source removal


diff --git a/net/minecraft/world/entity/item/FallingBlockEntity.java b/net/minecraft/world/entity/item/FallingBlockEntity.java
index 95a2c47dfaef33737afb4843ea5a784d0392046e..ab9d7fb89bb35f53dde36fbe2cc688e3e8c30e32 100644
--- a/net/minecraft/world/entity/item/FallingBlockEntity.java
+++ b/net/minecraft/world/entity/item/FallingBlockEntity.java
@@ -75,6 +75,7 @@ public class FallingBlockEntity extends Entity {
     public boolean forceTickAfterTeleportToDuplicate;
     protected static final EntityDataAccessor<BlockPos> DATA_START_POS = SynchedEntityData.defineId(FallingBlockEntity.class, EntityDataSerializers.BLOCK_POS);
     public boolean autoExpire = true; // Paper - Expand FallingBlock API
+    private boolean removeSourceOnFirstTick; // Reed - delayed source block removal
 
     public FallingBlockEntity(final EntityType<? extends FallingBlockEntity> type, final Level level) {
         super(type, level);
@@ -101,7 +102,12 @@ public class FallingBlockEntity extends Entity {
             state.hasProperty(BlockStateProperties.WATERLOGGED) ? state.setValue(BlockStateProperties.WATERLOGGED, false) : state
         );
         if (!org.bukkit.craftbukkit.event.CraftEventFactory.callEntityChangeBlockEvent(entity, pos, state.getFluidState().createLegacyBlock())) return entity; // CraftBukkit
-        level.setBlockAndUpdate(pos, state.getFluidState().createLegacyBlock());
+        // Reed start - delayed source block removal
+        entity.removeSourceOnFirstTick = net.windmilltown.reed.configuration.ReedConfiguration.get().gameplay.legacyFallingBlockEntityTicking;
+        if (!entity.removeSourceOnFirstTick) {
+            level.setBlockAndUpdate(pos, state.getFluidState().createLegacyBlock());
+        }
+        // Reed end - delayed source block removal
         level.addFreshEntity(entity);
         return entity;
     }
@@ -154,6 +160,16 @@ public class FallingBlockEntity extends Entity {
             this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
         } else {
             Block block = this.blockState.getBlock();
+            // Reed start - delayed source block removal
+            if (this.removeSourceOnFirstTick && this.time == 0) {
+                this.removeSourceOnFirstTick = false;
+                BlockPos startPos = this.getStartPos();
+                if (!this.level().getBlockState(startPos).is(block) || !this.level().removeBlock(startPos, false)) {
+                    this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN);
+                    return;
+                }
+            }
+            // Reed end - delayed source block removal
             this.time++;
             this.applyGravity();
             this.move(MoverType.SELF, this.getDeltaMovement());
