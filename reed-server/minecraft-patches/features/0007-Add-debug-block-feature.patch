+        final net.windmilltown.reed.debugblock.DebugBlockSettings settings,
+        final BlockState state,
+        final net.windmilltown.reed.debugblock.DebugBlockUpdateType cause
+    ) {
+        final boolean powered = level.hasNeighborSignal(pos) || settings.quasiConnectivity() && level.hasNeighborSignal(pos.above());
+        final boolean oldPowered = blockEntity.reed$getDebugBlock().isPowered();
+        if (powered == oldPowered) {
+            return;
+        }
+        blockEntity.reed$setPowered(powered);
+        final Direction front = powered ? Direction.UP : Direction.DOWN;
+        Direction top = state.getValue(ORIENTATION).top();
+        if (top.getAxis() == Direction.Axis.Y) {
+            top = Direction.EAST;
+        }
