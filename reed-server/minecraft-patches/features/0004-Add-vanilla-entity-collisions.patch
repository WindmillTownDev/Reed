+    // Reed start - vanilla entity collisions
+    public static double collideVanilla(final Direction.Axis axis, final AABB moving, final Iterable<VoxelShape> shapes, double distance) {
+        AxisCycle transform = AxisCycle.between(axis, Direction.Axis.X);
+        for (VoxelShape shape : shapes) {
+            if (Math.abs(distance) < 1.0E-7) {
+                return 0.0;
+            }
+
+            distance = shape.collideX(transform, moving, distance);
+        }
+
+        return distance;
+    }
+    // Reed end - vanilla entity collisions
