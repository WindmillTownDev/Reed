From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Windmill1055 <windmill1055@gmail.com>
Date: Tue, 28 Jul 2026 00:45:04 +0800
Subject: [PATCH] Implement player no clip API


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index e8713e5d7a3d7f7dc70556193cadbbd84e208500..b26dcf78bc0da85245c9c0e79a5d08c28b0a5b3f 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2431,6 +2431,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
         }
 
         this.getHandle().getAbilities().flying = value;
+        this.getHandle().reed$updateNoPhysics(); // Reed - player no clip
         if (needsUpdate) this.getHandle().onUpdateAbilities(); // Paper - Only refresh abilities if needed
     }
 
@@ -3374,4 +3375,14 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     public void setDoBlockPlacementUpdate(final boolean doBlockPlacementUpdate) {
         this.getHandle().setDoBlockPlacementUpdate(doBlockPlacementUpdate);
     }
+
+    @Override
+    public boolean isNoClip() {
+        return this.getHandle().reed$isNoClip();
+    }
+
+    @Override
+    public void setNoClip(final boolean noClip) {
+        this.getHandle().reed$setNoClip(noClip);
+    }
 }
