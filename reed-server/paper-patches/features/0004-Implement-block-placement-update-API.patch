From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Windmill1055 <windmill1055@gmail.com>
Date: Mon, 27 Jul 2026 18:58:08 +0800
Subject: [PATCH] Implement block placement update API


diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index f11ad0f2cdbb128dfa1f572903ad1b16b80c3e87..2527f37c40a9efbf0e47bb9bfe689f4933265c5e 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -3402,4 +3402,14 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     public PlayerPostEffects postEffects() {
         return new PaperPlayerPostEffects(this.getHandle());
     }
+
+    @Override
+    public boolean getDoBlockPlacementUpdate() {
+        return this.getHandle().getDoBlockPlacementUpdate();
+    }
+
+    @Override
+    public void setDoBlockPlacementUpdate(final boolean doBlockPlacementUpdate) {
+        this.getHandle().setDoBlockPlacementUpdate(doBlockPlacementUpdate);
+    }
 }
