From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Windmill1055 <windmill1055@gmail.com>
Date: Mon, 27 Jul 2026 18:58:04 +0800
Subject: [PATCH] Add block placement update API


diff --git a/src/main/java/org/bukkit/entity/Player.java b/src/main/java/org/bukkit/entity/Player.java
index 190313bc060d5f8440cec7c249ad1d2f1074f5bc..a09e7ce43bf6f4645a8c1ebe02ba0df9003424af 100644
--- a/src/main/java/org/bukkit/entity/Player.java
+++ b/src/main/java/org/bukkit/entity/Player.java
@@ -4084,4 +4084,20 @@ public interface Player extends HumanEntity, Conversable, OfflinePlayer, PluginM
      * @return the post-effects
      */
     PlayerPostEffects postEffects();
+
+    /**
+     * Gets whether block updates are performed when this player places a block.
+     * This value defaults to {@code true}.
+     *
+     * @return whether block placement updates are performed
+     */
+    boolean getDoBlockPlacementUpdate();
+
+    /**
+     * Sets whether block updates are performed when this player places a block.
+     * This setting only applies to block placement performed by this player.
+     *
+     * @param doBlockPlacementUpdate whether block placement updates are performed
+     */
+    void setDoBlockPlacementUpdate(boolean doBlockPlacementUpdate);
 }
